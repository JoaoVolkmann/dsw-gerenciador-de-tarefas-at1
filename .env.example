# Copie para .env (que NÃO vai para o Git) e preencha com os dados do SEU banco no Turso.
# Sem essas duas variáveis, o servidor usa o arquivo local tarefas.db.
# Salve em UTF-8 sem BOM. A URL vai sem barra "/" no final.
TURSO_URL=libsql://seu-banco.turso.io
TURSO_TOKEN=cole-aqui-o-token-do-turso
# Opcional localmente; no Render o JWT_SECRET é gerado sozinho.
# JWT_SECRET=um-texto-longo-e-aleatorio
