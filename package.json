{
  "name": "dsw-gerenciador-de-tarefas-at1",
  "version": "1.1.0",
  "description": "Gerenciador de tarefas multi-usuário (React + TypeScript, API Express com JWT e banco Turso) — disciplina de Desenvolvimento de Sistemas Web (DSW).",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "npm --prefix web install && npm run build:web && tsc",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaoVolkmann/dsw-gerenciador-de-tarefas-at1.git"
  },
  "keywords": [],
  "author": "João Volkmann",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JoaoVolkmann/dsw-gerenciador-de-tarefas-at1/issues"
  },
  "homepage": "https://github.com/JoaoVolkmann/dsw-gerenciador-de-tarefas-at1#readme",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
